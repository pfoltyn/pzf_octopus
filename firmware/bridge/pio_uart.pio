; Minimal PIO UART for the ESP32 bridge. 8 PIO cycles per bit; set the clock
; divider to sysclk / (8 * baud). 8N1.

.program uart_tx
.side_set 1 opt
    pull       side 1 [7]      ; idle line high while waiting for a byte
    set x, 7   side 0 [7]      ; start bit
bitloop:
    out pins, 1
    jmp x-- bitloop     [6]

.program uart_rx
    wait 0 pin 0               ; wait for start bit
    set x, 7        [10]       ; skip to middle of first data bit
bitloop:
    in pins, 1
    jmp x-- bitloop [6]
